PORT=3000
NODE_ENV=development

# MySQL instance A — Com7 source (READ-ONLY)
COM7_DB_HOST=localhost
COM7_DB_PORT=3306
COM7_DB_USER=readonly
COM7_DB_PASSWORD=
COM7_DB_NAME=com7

# MySQL instance B — ops store (mapping / pointer / state / queue)
OPS_DB_HOST=localhost
OPS_DB_PORT=3306
OPS_DB_USER=sync
OPS_DB_PASSWORD=
OPS_DB_NAME=sync_ops

# LarkBase API — app credentials are passed per-request via headers
# (X-Lark-App-Id / X-Lark-App-Secret), NOT here. Only the domain is config.
LARK_BASE_DOMAIN=https://open.larksuite.com

# POST /base/init soft time budget per call (ms)
BASE_INIT_BUDGET_MS=600000
